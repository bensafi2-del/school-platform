# Supabase project URL and publishable key only. Never use service_role or a secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# The origin of the platform website; set this before deploying.
CORS_ORIGINS=https://YOUR_SCHOOL_PLATFORM_HOST
MAX_FILE_BYTES=15728640
MAX_TOTAL_BYTES=47185920
MAX_FILES=8
ENABLE_API_DOCS=false
